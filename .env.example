# Gemini API key — used by app/api/generate-insight/route.ts to generate
# AI-powered comparison summaries. Get a free key at https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Analytics (auto-provided by Vercel when Analytics is enabled on the
# project — you usually don't need to set this manually, but included here
# for completeness if v0 scaffolded it into your project)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_vercel_analytics_id_here

# Supabase (only needed if you're actually using Supabase for auth/database —
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=your_dev_redirect_url_here
